{
  "name": "smartpro",
  "compatibility_date": "2026-09-22",

  "main": "./worker/index.js",

  "vars": {
    "CONTACT_FROM_EMAIL": "website@forms.smartproeg.com",
    "CONTACT_TO_EMAIL": "info@smartproeg.com",
  },

  "secrets": {
    "required": ["RESEND_API_KEY", "TURNSTILE_SECRET_KEY"],
  },

  "assets": {
    "directory": "./dist/",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
}
